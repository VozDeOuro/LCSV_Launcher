<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>Instance Console</title>
    <link rel="stylesheet" href="../node_modules/github-syntax-dark/lib/github-dark.css">
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { background: #1e1e1e; color: #d4d4d4; font-family: monospace; height: 100vh; display: flex; flex-direction: column; }
        #toolbar { background: #2d2d2d; padding: 8px 12px; display: flex; gap: 8px; align-items: center; border-bottom: 1px solid #444; flex-shrink: 0; }
        #toolbar button { background: #3a3a3a; border: 1px solid #555; color: #d4d4d4; padding: 4px 12px; cursor: pointer; border-radius: 3px; }
        #toolbar button:hover { background: #4a4a4a; }
        #status { margin-left: auto; color: #888; font-size: 12px; }
        #log { flex: 1; overflow-y: auto; padding: 8px; white-space: pre-wrap; word-break: break-all; font-size: 13px; line-height: 1.4; }
        #log .warn { color: #e5c07b; }
        #log .error { color: #e06c75; }
        #log .info { color: #98c379; }
    </style>
</head>
<body>
    <div id="toolbar">
        <button id="btn-upload">Upload to mclo.gs</button>
        <button id="btn-clear">Clear</button>
        <span id="status">Disconnected</span>
    </div>
    <div id="log"></div>
    <script src="./assets/js/scripts/console.js"></script>
</body>
</html>
